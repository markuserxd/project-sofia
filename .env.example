# Optional defaults. Set overrides in the process environment.
SOFIA_LOG_LEVEL=INFO
SOFIA_PROVIDER=mock
# Optional offline speech model, deliberately installed before launching the GUI.
# SOFIA_STT_MODEL_DIR=C:\SOFIA-models\whisper-base
# Optional paid Anthropic integration; a key alone does not authorize requests.
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
