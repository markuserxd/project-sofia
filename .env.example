# Optional defaults. Set overrides in the process environment.
SOFIA_LOG_LEVEL=INFO
SOFIA_PROVIDER=mock
# Optional offline speech model, deliberately installed before launching the GUI.
# SOFIA_STT_MODEL_DIR=C:\SOFIA-models\whisper-base
# Optional desktop chat credentials. Supply them to the process through a secret
# manager or a masked prompt. A key alone does not authorize requests.
# OPENAI_API_KEY=<your-openai-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
